unreal/TornVeilOnline/Content/Characters/
# Derived local palette content depends on licensed user library packages. Rebuild with
# create_local_architecture.py / create_local_prop_materials.py; do not redistribute.
unreal/TornVeilOnline/Content/TornVeil/LocalPalette/
unreal/TornVeilOnline/Content/TornVeil/Materials/LocalPalette/
# The Ashford garment meshes are project-owned geometry, but each one embeds the City Sample
# clothing skeleton's reference pose and binds to `SK_Base`, so on a machine without that
# licensed pack they are 19 MB of assets that cannot load. Same call as LocalPalette above: the
# generator is the source of truth. Rebuild with
#   blender --background --python art/tools/ashford_garments/build_garments.py
#   unreal/scripts/Run-EditorPython.ps1 -Script unreal/scripts/import_ashford_garments.py -Render
# `M_TV_AshfordCloth` is deliberately NOT ignored: it contains no vendor data, it is 12 KB, and
# the shader that decides what this culture looks like should be reviewable. Re-running the
# importer rebuilds it, so expect it to show as modified after an import.
unreal/TornVeilOnline/Content/TornVeil/Characters/Ashford/
# Machine-generated bindings embed licensed groom/face data; retain the generator only.
unreal/TornVeilOnline/Content/TornVeil/Characters/GroomBindings/
unreal/scripts/__pycache__/
.unrealmcp.json

# Automatic telemetry/anomaly/summary output from headless runs (v0.2 Part 3) and browser
# dev-session logging (v0.2 Part 18). Local developer instrumentation, not build output.
.debug/

# v0.10: browser-harness screenshots are regenerated evidence, not source. The few kept as
# milestone evidence live in docs/v0_10/.
tests/browser/artifacts/

# Python bytecode from the Blender-side garment tools.
art/tools/**/__pycache__/

# Web client build output
dist-web
web/public/models/*.glb
web/public/models/manifest.json

# CC0 KayKit sources for the Combat Arena; re-fetch with scripts/web/arena/fetch-kaykit.mjs
art/source/kaykit/

# Mixamo motion is used under Adobe terms but not redistributed as raw files: rebuild locally with
# art/tools/arena/build_mixamo_clips.py from your own Mixamo downloads (see docs/COMBAT_ARENA.md).
web/public/arena/mixamo_clips.glb
web/public/arena/mixamo_clips.json
web/public/arena/unarmed_clips.glb
web/public/arena/runtime-dependencies.json
# Ontology creator bodies, staged byte-for-byte from tools/ontology with hash checks: npm run web:creator
web/public/arena/creator/

# Reproducible canonical static geometry cooked from the verified focused GLBs.
web/public/focused/collision.json
