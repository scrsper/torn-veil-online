{
  "name": "torn-veil-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "observatory": "tsx src/observatory/server.ts",
    "observatory:benchmark": "tsx scripts/observatory/benchmark.ts",
    "observatory:check": "vitest run tests/observatory.test.ts tests/observatory-language.test.ts tests/dialogue-parser.test.ts tests/deterministic-dialogue.test.ts tests/player-language.test.ts tests/dialogue-live.test.ts",
    "bridge": "tsx src/bridge/server.ts",
    "bridge:verify": "tsx src/headless/bridge/livecheck.ts",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:bundle": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed --passWithNoTests",
    "test:branch": "vitest run --changed origin/main --passWithNoTests",
    "sim": "tsx src/headless/cli.ts",
    "kernel:demo": "tsx src/headless/kernel/cli.ts",
    "pressure:demo": "tsx src/headless/kernel/pressureCli.ts",
    "living:demo": "tsx src/headless/kernel/livingCli.ts",
    "continuity:accept": "vitest run --config vitest.continuity.config.ts",
    "world:smoke": "tsx src/headless/worldlab/cli.ts --tier smoke",
    "world:check": "tsx src/headless/worldlab/cli.ts --tier check",
    "world:soak": "tsx src/headless/worldlab/cli.ts --tier soak",
    "world:epoch": "tsx src/headless/worldlab/epochCli.ts",
    "test:browser": "tsx tests/browser/run.ts",
    "social:trace": "tsx src/headless/social/cli.ts",
    "motive:trace": "tsx src/headless/motive/cli.ts",
    "causal:trace": "tsx src/headless/causal/cli.ts",
    "economy:trace": "tsx src/headless/economy/cli.ts",
    "adapt:trace": "tsx src/headless/adaptive/cli.ts",
    "causal:accept": "vitest run --config vitest.accept.config.ts",
    "adapt:accept": "vitest run --config vitest.adaptive.config.ts",
    "epoch:accept": "vitest run --config vitest.epoch.config.ts",
    "world:settlements": "tsx src/headless/worldlab/settlementsCli.ts",
    "settlements:accept": "vitest run --config vitest.settlements.config.ts",
    "individual:demo": "tsx src/headless/individual/cli.ts",
    "agency:demo": "tsx src/headless/agency/cli.ts",
    "agency:worldlab": "tsx src/headless/worldlab/agencyCli.ts",
    "bridge:playable": "tsx src/bridge/playableServer.ts",
    "bridge:playable:verify": "tsx src/headless/bridge/playableStartup.ts",
    "foundational:accept": "tsx src/headless/bridge/foundationalGameplayAcceptance.ts",
    "appearance:sheet": "tsx src/headless/appearance/cli.ts",
    "foundry:report": "tsx src/headless/foundry/cli.ts",
    "foundry:fallback": "tsx src/headless/foundry/fallback.ts",
    "ashford:wardrobe": "tsx src/headless/foundry/ashfordWardrobe.ts",
    "web:dev": "vite --config vite.web.config.ts",
    "web:build": "tsc --noEmit && vite build --config vite.web.config.ts",
    "web:gateway": "tsx src/webgate/main.ts",
    "web:assets": "node scripts/web/build-assets.mjs",
    "web:play": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/web/Play-Web.ps1",
    "web:perf": "tsx scripts/web/perf.ts",
    "web:journey": "tsx scripts/web/journey.ts",
    "web:scenario": "tsx scripts/web/scenario.ts",
    "web:pad": "tsx scripts/web/pad.ts",
    "web:ui": "tsx scripts/web/uicheck.ts",
    "ontology:install": "npm ci --prefix tools/ontology",
    "ontology:check": "npm run typecheck --prefix tools/ontology && npm test --prefix tools/ontology",
    "ontology:build": "npm run build --prefix tools/ontology",
    "tooling": "tsx scripts/tooling/start.ts"
  },
  "dependencies": {
    "@babylonjs/core": "9.28.0",
    "@babylonjs/loaders": "9.28.0",
    "three": "^0.170.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  }
}
