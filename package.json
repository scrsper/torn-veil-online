{
  "name": "torn-veil-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bridge": "tsx src/bridge/server.ts",
    "bridge:verify": "tsx src/headless/bridge/livecheck.ts",
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "tsx src/headless/cli.ts",
    "world:smoke": "tsx src/headless/worldlab/cli.ts --tier smoke",
    "world:check": "tsx src/headless/worldlab/cli.ts --tier check",
    "world:soak": "tsx src/headless/worldlab/cli.ts --tier soak",
    "world:epoch": "tsx src/headless/worldlab/epochCli.ts",
    "test:browser": "tsx tests/browser/run.ts",
    "social:trace": "tsx src/headless/social/cli.ts",
    "motive:trace": "tsx src/headless/motive/cli.ts",
    "causal:trace": "tsx src/headless/causal/cli.ts",
    "adapt:trace": "tsx src/headless/adaptive/cli.ts",
    "causal:accept": "vitest run --config vitest.accept.config.ts",
    "adapt:accept": "vitest run --config vitest.adaptive.config.ts",
    "epoch:accept": "vitest run --config vitest.epoch.config.ts",
    "world:settlements": "tsx src/headless/worldlab/settlementsCli.ts",
    "settlements:accept": "vitest run --config vitest.settlements.config.ts"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.11"
  }
}
